# Notion API
NOTION_API_KEY=secret_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
NOTION_SERVICES_DB_ID=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
NOTION_BLOG_DB_ID=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
NOTION_COMPANY_PAGE_ID=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Site
NEXT_PUBLIC_SITE_URL=https://www.zest2020.com

# Google Analytics
# 本番の測定IDは src/lib/analytics.ts の PRODUCTION_GA_ID で管理している（公開値のため）。
# 本番ドメイン以外では計測しないので、通常この変数は設定不要。
# プレビュー環境で一時的に計測を試したいときだけ上書きする。
NEXT_PUBLIC_GA_ID=

# Google Search Console のドメイン所有権確認（HTMLタグ方式を使う場合のみ）
NEXT_PUBLIC_GSC_VERIFICATION=

# インサイドセールス入口（資料請求・打ち合わせ申込）の通知先
# 未設定の場合は SLACK_WEBHOOK_URL（チャットのエスカレーションと同じチャンネル）にフォールバック
SLACK_IS_WEBHOOK_URL=

# 営業メールの配信停止リンクの署名鍵
# sales-automation 側の .env にも同じ値を入れること。値が食い違うと、
# 送ったリンクをサーバーが検証できず、相手が配信停止できなくなる。
# 生成例: openssl rand -base64 32
UNSUBSCRIBE_SECRET=
